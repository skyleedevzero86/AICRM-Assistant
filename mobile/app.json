{
  "expo": {
    "name": "AICRM 고객센터",
    "slug": "aicrm-assistant-mobile",
    "version": "0.1.1",
    "scheme": "aicrm",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      }
    },
    "plugins": ["expo-router"],
    "extra": {
      "apiBaseUrl": "http://localhost:8080",
      "router": {
        "origin": false
      }
    }
  }
}
